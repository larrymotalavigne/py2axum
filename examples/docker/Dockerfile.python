# The same application under uvicorn: the sidecar that serves the routes left to Python
# (`--python-side`). Only the binary talks to it.
#   docker build -f examples/docker/Dockerfile.python -t bookshelf-python .
FROM python:3.13-slim
ARG APP_DIR=examples/bookshelf
WORKDIR /src
COPY ${APP_DIR}/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY ${APP_DIR}/ .
EXPOSE 8000
USER nobody
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
